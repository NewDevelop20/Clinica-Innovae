# Copia este fichero a .env para probar en local. NUNCA subas .env a GitHub.

# --- IA ---------------------------------------------------------------
# Sin clave: deja MODO_SIMULADO=1 para probar todo el circuito sin IA.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
MODO_SIMULADO=1

# --- Reservas: URL /exec del Web App de Code.gs ----------------------
APPS_SCRIPT_URL=

# --- WhatsApp Cloud API (developers.facebook.com > tu app > WhatsApp) -
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=inventa-una-frase-larga-aqui
WHATSAPP_APP_SECRET=

# --- Webs que pueden usar el chat (separadas por comas) --------------
ORIGENES_PERMITIDOS=https://newdevelop20.github.io,http://localhost:8000
